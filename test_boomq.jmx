              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Save Credentials" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def outputFile = new File(
    org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(),
    vars.get(&apos;uc_filename&apos;)
)

outputFile.withWriterAppend(&apos;UTF-8&apos;) { writer -&gt;
    writer.println(&quot;${vars.get(&apos;user_email&apos;)},${vars.get(&apos;user_name&apos;)},${vars.get(&apos;team_id&apos;)}&quot;)
}</stringProp>
              </JSR223Sampler>
