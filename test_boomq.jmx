              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Random Project ID" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def teamId = vars.get(&apos;team_id&apos;)

def ids = teamId == &apos;1&apos;
    ? [&apos;634&apos;, &apos;635&apos;, &apos;636&apos;, &apos;637&apos;, &apos;638&apos;]
