            <hashTree>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Prepare Test Project Payload" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

try {
    def response = prev.getResponseDataAsString()
    def group = new JsonSlurper().parseText(response)
    group.allocationGroupConfig = [
        testRunLocationId: 1,
        type: &quot;ENT_DOCKER&quot;
    ]

    def payload = [
        comment: &quot;&quot;,
        contentFormat: &quot;yaml&quot;,
        contentModelVersion: &quot;3.0.0&quot;,
        labelSet: [],
        projectName: vars.get(&quot;test_name&quot;),
        settingsId: null,
        testType: &quot;OWN_JMX&quot;,
        contentV3: [
            allocationGroupList: [group],
            slaGroupList: [
                [
                    type: &quot;GENERAL_TEST_SLA&quot;,
                    targetType: &quot;TEST&quot;,
                    slaList: [
                        [
                            fromDate: 0,
                            restrictionType: &quot;AVERAGE&quot;,
                            operation: &quot;LESS_EQUALS&quot;,
                            status: &quot;NOT_COUNTED&quot;,
                            toDate: 4,
                            value: &quot;0.5&quot;
                        ]
                    ]
                ]
            ]
        ],
        requestCount: group.requestCount ?: 1,
        totalDuration: group.totalDuration ?: 4
    ]

    vars.put(&quot;test_project_body&quot;, JsonOutput.toJson(payload))
} catch (Exception e) {
    log.error(&quot;Failed to build test project payload: &quot; + e.getMessage(), e)
}
</stringProp>
              </JSR223PostProcessor>
