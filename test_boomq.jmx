          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Random team_id" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">int teamId = Math.random() &lt; 0.5 ? 1 : 6
vars.put(&apos;team_id&apos;, teamId.toString())</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Random user" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def csvFile = new File(
    org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(),
    &apos;UC01_user_credentials.csv&apos;
)

def rows = csvFile.readLines(&apos;UTF-8&apos;)

def matchingRows = rows.findAll { line -&gt;
    def columns = line.split(&apos;,&apos;, -1)
    columns.length &gt;= 3 &amp;&amp; columns[2].trim() == vars.get(&apos;team_id&apos;)
}

if (matchingRows.isEmpty()) {
    throw new IllegalStateException(
        &quot;No users found for team_id=${vars.get(&apos;team_id&apos;)}&quot;
    )
}

def selected = matchingRows[
    new Random().nextInt(matchingRows.size())
].split(&apos;,&apos;, -1)

vars.put(&apos;user_email&apos;, selected[0].trim())
vars.put(&apos;user_name&apos;, selected[1].trim())</stringProp>
          </JSR223Sampler>
