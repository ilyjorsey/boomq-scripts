                <stringProp name="script">def teamId = vars.get(&apos;team_id&apos;)

def ids = teamId == &apos;1&apos;
    ? [&apos;202&apos;, &apos;207&apos;, &apos;627&apos;, &apos;628&apos;, &apos;629&apos;]
    : [&apos;634&apos;, &apos;635&apos;, &apos;636&apos;, &apos;637&apos;, &apos;638&apos;]

vars.put(&apos;random_project_id&apos;, ids[new Random().nextInt(ids.size())])</stringProp>
